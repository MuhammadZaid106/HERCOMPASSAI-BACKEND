# ─── Runtime ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Neon PostgreSQL connection string. Leave empty to run without a database:
# the Gateway then serves deterministic responses and skips AI audit persistence.
DATABASE_URL=

# Must be at least 32 characters each.
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# OAuth 2.0 client ID from Google Cloud Console → APIs & Services → Credentials.
# Required by POST /api/auth/google, which verifies the browser's ID token
# (signature, audience, issuer, expiry) before trusting any claim. Leave empty
# to disable Google sign-in: the route then returns 503.
GOOGLE_CLIENT_ID=

# Public site for links inside email. Use http://localhost:3000 while the new pages
# exist only on this machine. Switch to https://hercompassai.vercel.app after that
# code is deployed, or the email opens a missing page on the live site.
FRONTEND_URL=http://localhost:3000

# Gmail address, app password, and the From address. Leave empty to boot without mail.
SMTP_USER=
SMTP_APP_PASSWORD=
MAIL_FROM=

# ─── HerCompass AI Gateway ─────────────────────────────────────────────────────
# Master switch. When false the Gateway rejects every AI request with 503.
AI_GATEWAY_ENABLED=true

# Version stamps written to every AI audit record. Bump when behaviour changes so
# a historical decision can be reconstructed.
# SCI is the Self-Checking Integrity pass. AI_GATEWAY_CI_VERSION is a legacy
# alias, read only when AI_GATEWAY_SCI_VERSION is unset.
AI_GATEWAY_SCI_VERSION=1.0
AI_GATEWAY_EVIDENCE_VERSION=1.0
AI_GATEWAY_CONFIG_VERSION=1.0

AI_GATEWAY_TIMEOUT_MS=45000
# Omit to follow AI_GATEWAY_TIMEOUT_MS. A stricter probe than the generation budget
# reports a healthy engine as unavailable, so this must never be the smaller value.
# AI_GATEWAY_HEALTH_TIMEOUT_MS=45000
# Extra engines attempted after the primary. 1 = two attempts total.
AI_GATEWAY_MAX_FALLBACK_ATTEMPTS=1
# Minimum lexical relevance a Clinical Knowledge Folder record must reach to be
# allowed into model context.
AI_GATEWAY_EVIDENCE_MIN_RELEVANCE=0.12

# ─── Model Providers ───────────────────────────────────────────────────────────
# Replaceable engines behind the Gateway. Feature modules never reference these
# directly; the router selects an engine from configuration.
# An engine without both a URL and a MODEL reports itself as not_configured and
# the Gateway moves to the next route without calling it.
#
# IMPORTANT: *_PROVIDER_URL is the SERVER ROOT ONLY.
# Llama and Med42 use the OpenAI-compatible transport, which appends
# "/v1/chat/completions" itself, so a URL that already ends in /v1 produces
# /v1/v1/chat/completions and a confusing 404. Gemini uses the native
# generateContent transport, which appends "/models/<MODEL>:generateContent"
# to a root that already includes the version segment. See each block below.
#
# Hugging Face Inference API (hosted):
#   1. Create a token: https://huggingface.co/settings/tokens  (Read is enough)
#   2. Set *_PROVIDER_KEY to that token — it is sent as "Authorization: Bearer".
#   3. Leave the URL as https://router.huggingface.co for both engines.
#   4. Pick MODEL from a chat/instruct repo. Bare base checkpoints such as
#      "meta-llama/Llama-3.1-8B" usually need a PRO licence and may not be
#      served by the hosted API; use an open mirror or self-host with TGI/vLLM
#      if you hit a 401/403 from Hugging Face.
LLAMA_PROVIDER_URL=https://router.huggingface.co
LLAMA_PROVIDER_KEY=
LLAMA_MODEL=
LLAMA_MODEL_VERSION=

# Med42 is the clinical-domain engine, so the router prefers it for clinically
# framed routes. Med42 weights are large; on the hosted API expect a slower
# cold start than Llama.
MED42_PROVIDER_URL=https://router.huggingface.co
MED42_PROVIDER_KEY=
MED42_MODEL=
MED42_MODEL_VERSION=

# Google Gemini, on the native generateContent API.
#   1. Create a key: https://aistudio.google.com/apikey
#   2. Set GEMINI_PROVIDER_KEY to it — it is sent as the "x-goog-api-key" header.
#   3. GEMINI_PROVIDER_URL is the API ROOT ONLY. Unlike the two engines above it
#      already carries the version segment, because the Gateway appends
#      "/models/<GEMINI_MODEL>:generateContent" itself. A URL ending in
#      "/v1beta/openai" or "/v1/chat/completions" will not resolve.
#   4. GEMINI_MODEL is the bare model id, without the "models/" prefix — e.g.
#      "gemini-3.8-flash". An unknown id answers 404 NOT_FOUND, which the health
#      probe reports as "degraded" alongside Google's own explanation.
#      Free tier, no card required: gemini-3.8-flash, gemini-3.7/3.6/3.5-flash,
#      gemini-3.5-flash-lite, gemini-3.1-flash-lite, gemma-4. The 2.5 models are
#      restricted to projects that used them before 2026-09-18 and will 404 for
#      a new key.
#   5. GEMINI_MODEL_VERSION is the published snapshot date from the model card.
#      Pin it so an upstream model update cannot silently alter past AI decisions.
#      It is a provenance label written to ai_audit_logs, never sent to Google.
GEMINI_PROVIDER_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_PROVIDER_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_MODEL_VERSION=
